# Copy to .env and adjust. Every value has a safe CPU-only default in src/config.py.

# --- paths ---
PRISM_CORPUS_DIR=data/corpus
PRISM_LOG_DIR=logs
PRISM_INDEX_DIR=indexes

# --- chunking ---
PRISM_CHUNK_MAX_TOKENS=400
PRISM_CHUNK_OVERLAP_TOKENS=40

# --- retrieval ---
# hashing = numpy feature-hashing embedder (no download, not semantic)
# sentence_transformers = real dense model (requires requirements-optional.txt)
PRISM_DENSE_BACKEND=hashing
PRISM_DENSE_MODEL=BAAI/bge-small-en-v1.5
# lexical = term-overlap reranker (no download) | cross_encoder | none
PRISM_RERANK_BACKEND=lexical
PRISM_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PRISM_RRF_K=60
PRISM_CANDIDATES=20
PRISM_TOP_K=5

# --- uncertainty ---
# Minimum fraction of query content terms that must appear in the best evidence chunk.
PRISM_MIN_EVIDENCE_SCORE=0.34

# --- suppression gate: classifier-fallback probability above which a turn is presentation-only ---
PRISM_GATE_THRESHOLD=0.5

# --- stability probe: BM25 top-k size and content-sufficiency minimums ---
PRISM_PROBE_K=3
PRISM_PROBE_MIN_CONTENT_TERMS=2
PRISM_PROBE_MIN_TOKENS=4

# --- retrieval controller: rule_only | rule_stability | llm (llm needs PRISM_LLM_PROVIDER) ---
# Defaults tuned on the dev scenarios in step 2.7; see reports/PHASE_2_CONTROLLER_ABLATION.md
PRISM_CONTROLLER_MODE=rule_only
# stability score needed for a chunk to count as stable, and consecutive stable chunks (N)
PRISM_STABILITY_THRESHOLD=0.2
PRISM_STABLE_CHUNKS=1
# provisional retrievals allowed per utterance
PRISM_MAX_PROVISIONAL=1

# --- multi-intent decomposition: rules (CPU default) | llm (needs PRISM_LLM_PROVIDER) ---
PRISM_DECOMPOSER=rules
# anti-fragmentation guard (1 = on): cap, embedding-similarity merge, minimum content words per sub-query
PRISM_ANTI_FRAGMENTATION=1
PRISM_MAX_SUBQUERIES=4
PRISM_SUBQUERY_MERGE_SIMILARITY=0.85
PRISM_SUBQUERY_MIN_CONTENT_TERMS=2
# evidence fusion across sub-queries: final evidence size, per-sub-intent quota, near-duplicate Jaccard
PRISM_FUSION_TOP_K=6
PRISM_FUSION_QUOTA=2
PRISM_FUSION_NEAR_DUPLICATE=0.9
# speculative reuse cache: query similarity (term Jaccard) to reuse an earlier search in the same utterance; 0 = off
PRISM_CACHE_SIMILARITY=0.75

# --- grounding verifier: lexical (CPU proxy) | nli (optional model) | llm (needs PRISM_LLM_PROVIDER) ---
PRISM_GROUNDING_JUDGE=lexical
# drop unsupported claims, or keep and flag them
PRISM_GROUNDING_MODE=drop
# lexical judge: share of a claim's content words that must appear in its cited chunks
PRISM_LEXICAL_SUPPORT_THRESHOLD=0.8

# --- LLM (all calls go through src/llm/client.py) ---
# none = no LLM; the baseline answers extractively from retrieved chunks
# ollama | openai_compatible = configured by the infrastructure owner
PRISM_LLM_PROVIDER=none
PRISM_LLM_MODEL=
PRISM_LLM_BASE_URL=http://localhost:11434
PRISM_LLM_API_KEY=
PRISM_LLM_TIMEOUT_S=120
PRISM_LLM_MAX_TOKENS=512
# Estimated cost per 1K tokens (USD) for telemetry. 0 for local models.
PRISM_COST_PER_1K_INPUT=0
PRISM_COST_PER_1K_OUTPUT=0

# --- demo ---
SAMPLE_QUERY=What are the technical evaluation gates and their target thresholds?
